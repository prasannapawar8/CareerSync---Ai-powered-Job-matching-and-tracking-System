{
  "manifest_version": 3,
  "name": "CareerSync Web Clipper",
  "version": "1.0",
  "description": "Clip jobs from anywhere directly to your CareerSync Kanban board.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ]
}
